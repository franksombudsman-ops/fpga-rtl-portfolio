#include <linux/module.h>
#include <linux/platform_device.h>
#include <linux/of.h>
#include <linux/io.h>
#include <linux/interrupt.h>
#include <linux/dma-mapping.h>
#include <linux/jiffies.h>
#include <linux/delay.h>
#include <linux/bitops.h>
#include <linux/wait.h>
#include <linux/kernel.h>

#define P07_ID                  0x000
#define P07_VERSION             0x004
#define P07_GLOBAL_CONTROL      0x008

#define P07_IRQ_STATUS          0x010
#define P07_IRQ_ENABLE          0x014
#define P07_ERROR_STATUS        0x018

#define P07_TX_CONTROL          0x100
#define P07_TX_BASE_LO          0x108
#define P07_TX_BASE_HI          0x10C
#define P07_TX_RING_SIZE        0x110
#define P07_TX_TAIL             0x114
#define P07_TX_HEAD             0x118
#define P07_TX_BYTES_LO         0x11C
#define P07_TX_BYTES_HI         0x120
#define P07_TX_DESC_COUNT       0x124

#define P07_RX_CONTROL          0x200
#define P07_RX_BASE_LO          0x208
#define P07_RX_BASE_HI          0x20C
#define P07_RX_RING_SIZE        0x210
#define P07_RX_TAIL             0x214
#define P07_RX_HEAD             0x218
#define P07_RX_BYTES_LO         0x21C
#define P07_RX_BYTES_HI         0x220
#define P07_RX_DESC_COUNT       0x224

#define P07_GLOBAL_ENABLE       BIT(0)
#define P07_SOFT_RESET          BIT(1)
#define P07_COUNTER_CLEAR       BIT(2)

#define P07_CHANNEL_ENABLE      BIT(0)

#define P07_IRQ_TX_COMPLETE     BIT(0)
#define P07_IRQ_RX_COMPLETE     BIT(1)
#define P07_IRQ_TX_ERROR        BIT(2)
#define P07_IRQ_RX_ERROR        BIT(3)

#define P07_IRQ_COMPLETIONS \
	(P07_IRQ_TX_COMPLETE | P07_IRQ_RX_COMPLETE)

#define P07_IRQ_ERRORS \
	(P07_IRQ_TX_ERROR | P07_IRQ_RX_ERROR)

#define P07_IRQ_ALL \
	(P07_IRQ_COMPLETIONS | P07_IRQ_ERRORS)

#define P07_EXPECTED_ID         0x43444D41
#define P07_EXPECTED_VERSION    0x00010000

#define P07_DMA_BITS            40
#define P07_RING_ENTRIES        16
#define P07_DESC_BYTES          64
#define P07_PAYLOAD_BYTES       64
#define P07_TIMEOUT_MS          1000

struct project07_desc {
	__le64 buffer_addr;
	__le32 length;
	__le32 control;
	__le64 cookie;
	__le32 status;
	__le32 actual_length;
	u8 reserved[32];
};

struct project07_dma {
	void __iomem *regs;
	int irq;

	void *tx_ring_cpu;
	dma_addr_t tx_ring_dma;
	void *tx_payload_cpu;
	dma_addr_t tx_payload_dma;

	void *rx_ring_cpu;
	dma_addr_t rx_ring_dma;
	void *rx_payload_cpu;
	dma_addr_t rx_payload_dma;

	wait_queue_head_t irq_wq;
	atomic_t irq_count;
	atomic_t seen_irq;
};

static const u64 p07_payload[8] = {
	0x2222222211111111ULL,
	0x4444444433333333ULL,
	0x6666666655555555ULL,
	0x8888888877777777ULL,
	0xAAAAAAAA99999999ULL,
	0xCCCCCCCCBBBBBBBBULL,
	0xEEEEEEEEDDDDDDDDULL,
	0x12345678FFFFFFFFULL,
};

static irqreturn_t project07_dma_irq(int irq, void *data)
{
	struct project07_dma *dma = data;
	u32 pending;

	pending = readl(dma->regs + P07_IRQ_STATUS) &
		  P07_IRQ_ALL;

	if (!pending)
		return IRQ_NONE;

	atomic_inc(&dma->irq_count);
	atomic_or(pending, &dma->seen_irq);

	/* IRQ_STATUS is RW1C. */
	writel(pending, dma->regs + P07_IRQ_STATUS);
	(void)readl(dma->regs + P07_IRQ_STATUS);

	wake_up(&dma->irq_wq);

	return IRQ_HANDLED;
}

static int project07_gate9l(struct platform_device *pdev,
			    struct project07_dma *dma)
{
	struct device *dev = &pdev->dev;
	struct project07_desc *txd;
	struct project07_desc *rxd;
	__le64 *tx_words;
	__le64 *rx_words;
	unsigned long timeout;

	u32 seen;
	u32 irq_after_ack;
	u32 error_status;

	u32 tx_control;
	u32 tx_status;
	u32 tx_actual;
	u32 tx_head;
	u64 tx_bytes;
	u32 tx_desc;

	u32 rx_control;
	u32 rx_status;
	u32 rx_actual;
	u32 rx_head;
	u64 rx_bytes;
	u32 rx_desc;

	int irq_count;
	int i;

	BUILD_BUG_ON(sizeof(struct project07_desc) !=
		     P07_DESC_BYTES);

	dma->tx_ring_cpu =
		dmam_alloc_coherent(dev,
			P07_RING_ENTRIES * P07_DESC_BYTES,
			&dma->tx_ring_dma,
			GFP_KERNEL);

	dma->tx_payload_cpu =
		dmam_alloc_coherent(dev,
			P07_PAYLOAD_BYTES,
			&dma->tx_payload_dma,
			GFP_KERNEL);

	dma->rx_ring_cpu =
		dmam_alloc_coherent(dev,
			P07_RING_ENTRIES * P07_DESC_BYTES,
			&dma->rx_ring_dma,
			GFP_KERNEL);

	dma->rx_payload_cpu =
		dmam_alloc_coherent(dev,
			P07_PAYLOAD_BYTES,
			&dma->rx_payload_dma,
			GFP_KERNEL);

	if (!dma->tx_ring_cpu ||
	    !dma->tx_payload_cpu ||
	    !dma->rx_ring_cpu ||
	    !dma->rx_payload_cpu)
		return -ENOMEM;

	memset(dma->tx_ring_cpu, 0,
	       P07_RING_ENTRIES * P07_DESC_BYTES);

	memset(dma->rx_ring_cpu, 0,
	       P07_RING_ENTRIES * P07_DESC_BYTES);

	memset(dma->rx_payload_cpu, 0,
	       P07_PAYLOAD_BYTES);

	tx_words = dma->tx_payload_cpu;

	for (i = 0; i < 8; i++)
		tx_words[i] = cpu_to_le64(p07_payload[i]);

	txd = dma->tx_ring_cpu;
	rxd = dma->rx_ring_cpu;

	/* Valid TX descriptor. */
	txd[0].buffer_addr =
		cpu_to_le64((u64)dma->tx_payload_dma);
	txd[0].length =
		cpu_to_le32(P07_PAYLOAD_BYTES);
	txd[0].control =
		cpu_to_le32(0x7);
	txd[0].cookie =
		cpu_to_le64(0x47415445394C5458ULL);

	/* Valid RX descriptor. */
	rxd[0].buffer_addr =
		cpu_to_le64((u64)dma->rx_payload_dma);
	rxd[0].length =
		cpu_to_le32(P07_PAYLOAD_BYTES);
	rxd[0].control =
		cpu_to_le32(0x7);
	rxd[0].cookie =
		cpu_to_le64(0x47415445394C5258ULL);

	dev_info(dev,
		 "Project07 Gate9L TX ring=%pad payload=%pad RX ring=%pad payload=%pad\n",
		 &dma->tx_ring_dma,
		 &dma->tx_payload_dma,
		 &dma->rx_ring_dma,
		 &dma->rx_payload_dma);

	/*
	 * Establish known stopped state.
	 */
	writel(0, dma->regs + P07_IRQ_ENABLE);
	writel(0, dma->regs + P07_TX_CONTROL);
	writel(0, dma->regs + P07_RX_CONTROL);

	writel(P07_SOFT_RESET,
	       dma->regs + P07_GLOBAL_CONTROL);

	(void)readl(dma->regs + P07_GLOBAL_CONTROL);
	udelay(10);

	writel(P07_COUNTER_CLEAR,
	       dma->regs + P07_GLOBAL_CONTROL);

	writel(P07_IRQ_ALL,
	       dma->regs + P07_IRQ_STATUS);

	writel(0xffffffff,
	       dma->regs + P07_ERROR_STATUS);

	(void)readl(dma->regs + P07_IRQ_STATUS);

	atomic_set(&dma->irq_count, 0);
	atomic_set(&dma->seen_irq, 0);

	/*
	 * Configure TX ring.
	 * BASE first, SIZE last = commit.
	 */
	writel(lower_32_bits(dma->tx_ring_dma),
	       dma->regs + P07_TX_BASE_LO);

	writel(upper_32_bits(dma->tx_ring_dma),
	       dma->regs + P07_TX_BASE_HI);

	writel(P07_RING_ENTRIES,
	       dma->regs + P07_TX_RING_SIZE);

	/*
	 * Configure RX ring.
	 */
	writel(lower_32_bits(dma->rx_ring_dma),
	       dma->regs + P07_RX_BASE_LO);

	writel(upper_32_bits(dma->rx_ring_dma),
	       dma->regs + P07_RX_BASE_HI);

	writel(P07_RING_ENTRIES,
	       dma->regs + P07_RX_RING_SIZE);

	/*
	 * Publish descriptors/payload before tail ownership becomes
	 * visible to hardware.
	 */
	dma_wmb();

	writel(1, dma->regs + P07_TX_TAIL);
	writel(1, dma->regs + P07_RX_TAIL);

	/*
	 * Listen for both completions and both error causes.
	 */
	writel(P07_IRQ_ALL,
	       dma->regs + P07_IRQ_ENABLE);

	/*
	 * Arm both engines while global DMA is still disabled.
	 * GLOBAL_ENABLE below becomes the common launch point.
	 */
	writel(P07_CHANNEL_ENABLE,
	       dma->regs + P07_TX_CONTROL);

	writel(P07_CHANNEL_ENABLE,
	       dma->regs + P07_RX_CONTROL);

	dev_info(dev,
		 "Project07 Gate9L TX/RX armed; issuing common global launch\n");

	writel(P07_GLOBAL_ENABLE,
	       dma->regs + P07_GLOBAL_CONTROL);

	(void)readl(dma->regs + P07_GLOBAL_CONTROL);

	timeout =
		wait_event_timeout(
			dma->irq_wq,
			(((atomic_read(&dma->seen_irq) &
			   P07_IRQ_COMPLETIONS) ==
			  P07_IRQ_COMPLETIONS) ||
			 (atomic_read(&dma->seen_irq) &
			  P07_IRQ_ERRORS)),
			msecs_to_jiffies(P07_TIMEOUT_MS));

	dma_rmb();

	seen = atomic_read(&dma->seen_irq);
	irq_count = atomic_read(&dma->irq_count);

	irq_after_ack =
		readl(dma->regs + P07_IRQ_STATUS);

	error_status =
		readl(dma->regs + P07_ERROR_STATUS);

	tx_control = le32_to_cpu(txd[0].control);
	tx_status = le32_to_cpu(txd[0].status);
	tx_actual = le32_to_cpu(txd[0].actual_length);

	tx_head =
		readl(dma->regs + P07_TX_HEAD);

	tx_bytes =
		(u64)readl(dma->regs + P07_TX_BYTES_LO) |
		((u64)readl(dma->regs + P07_TX_BYTES_HI) << 32);

	tx_desc =
		readl(dma->regs + P07_TX_DESC_COUNT);

	rx_control = le32_to_cpu(rxd[0].control);
	rx_status = le32_to_cpu(rxd[0].status);
	rx_actual = le32_to_cpu(rxd[0].actual_length);

	rx_head =
		readl(dma->regs + P07_RX_HEAD);

	rx_bytes =
		(u64)readl(dma->regs + P07_RX_BYTES_LO) |
		((u64)readl(dma->regs + P07_RX_BYTES_HI) << 32);

	rx_desc =
		readl(dma->regs + P07_RX_DESC_COUNT);

	dev_info(dev,
		 "Project07 Gate9L IRQ result: irq_count=%d seen_irq=0x%08x irq_after_ack=0x%08x error_status=0x%08x\n",
		 irq_count,
		 seen,
		 irq_after_ack,
		 error_status);

	dev_info(dev,
		 "Project07 Gate9L TX result: control=0x%08x status=0x%08x actual=%u head=%u bytes=%llu desc=%u\n",
		 tx_control,
		 tx_status,
		 tx_actual,
		 tx_head,
		 (unsigned long long)tx_bytes,
		 tx_desc);

	dev_info(dev,
		 "Project07 Gate9L RX result: control=0x%08x status=0x%08x actual=%u head=%u bytes=%llu desc=%u\n",
		 rx_control,
		 rx_status,
		 rx_actual,
		 rx_head,
		 (unsigned long long)rx_bytes,
		 rx_desc);

	rx_words = dma->rx_payload_cpu;

	for (i = 0; i < 8; i++)
		dev_info(dev,
			 "Project07 Gate9L RX payload[%d]=0x%016llx expected=0x%016llx\n",
			 i,
			 (unsigned long long)
			 le64_to_cpu(rx_words[i]),
			 (unsigned long long)
			 p07_payload[i]);

	/*
	 * Quiet hardware after collecting evidence.
	 */
	writel(0, dma->regs + P07_IRQ_ENABLE);
	writel(0, dma->regs + P07_TX_CONTROL);
	writel(0, dma->regs + P07_RX_CONTROL);
	writel(0, dma->regs + P07_GLOBAL_CONTROL);

	if (!timeout) {
		dev_err(dev,
			"Project07 Gate9L FAIL: simultaneous TX/RX completion timed out\n");
		return -ETIMEDOUT;
	}

	if (seen & P07_IRQ_ERRORS) {
		dev_err(dev,
			"Project07 Gate9L FAIL: DMA error IRQ seen=0x%08x\n",
			seen);
		return -EIO;
	}

	if ((seen & P07_IRQ_COMPLETIONS) !=
	    P07_IRQ_COMPLETIONS) {
		dev_err(dev,
			"Project07 Gate9L FAIL: missing completion IRQ cause, seen=0x%08x\n",
			seen);
		return -EIO;
	}

	if (irq_after_ack != 0 ||
	    error_status != 0) {
		dev_err(dev,
			"Project07 Gate9L FAIL: irq_after=0x%08x error_status=0x%08x\n",
			irq_after_ack,
			error_status);
		return -EIO;
	}

	if (tx_control != 0x6 ||
	    tx_status != 0x1 ||
	    tx_actual != P07_PAYLOAD_BYTES ||
	    tx_head != 1 ||
	    tx_bytes != P07_PAYLOAD_BYTES ||
	    tx_desc != 1) {
		dev_err(dev,
			"Project07 Gate9L FAIL: TX retirement/accounting mismatch\n");
		return -EIO;
	}

	if (rx_control != 0x6 ||
	    rx_status != 0x1 ||
	    rx_actual != P07_PAYLOAD_BYTES ||
	    rx_head != 1 ||
	    rx_bytes != P07_PAYLOAD_BYTES ||
	    rx_desc != 1) {
		dev_err(dev,
			"Project07 Gate9L FAIL: RX retirement/accounting mismatch\n");
		return -EIO;
	}

	for (i = 0; i < 8; i++) {
		u64 got = le64_to_cpu(rx_words[i]);

		if (got != p07_payload[i]) {
			dev_err(dev,
				"Project07 Gate9L FAIL: RX payload word %d got=0x%016llx expected=0x%016llx\n",
				i,
				(unsigned long long)got,
				(unsigned long long)p07_payload[i]);
			return -EIO;
		}
	}

	dev_info(dev,
		 "Project07 Gate9L PASS: simultaneous Linux TX/RX DMA completed with both descriptors retired and exact RX payload\n");

	return 0;
}

static int project07_dma_probe(struct platform_device *pdev)
{
	struct project07_dma *dma;
	u32 id;
	u32 version;
	int ret;

	dma = devm_kzalloc(&pdev->dev,
			   sizeof(*dma),
			   GFP_KERNEL);

	if (!dma)
		return -ENOMEM;

	dma->regs =
		devm_platform_ioremap_resource(pdev, 0);

	if (IS_ERR(dma->regs))
		return PTR_ERR(dma->regs);

	id = readl(dma->regs + P07_ID);
	version = readl(dma->regs + P07_VERSION);

	dev_info(&pdev->dev,
		 "Project07 DMA probe: ID=0x%08x VERSION=0x%08x\n",
		 id, version);

	if (id != P07_EXPECTED_ID ||
	    version != P07_EXPECTED_VERSION)
		return -ENODEV;

	ret =
		dma_set_mask_and_coherent(
			&pdev->dev,
			DMA_BIT_MASK(P07_DMA_BITS));

	if (ret)
		return ret;

	init_waitqueue_head(&dma->irq_wq);
	atomic_set(&dma->irq_count, 0);
	atomic_set(&dma->seen_irq, 0);

	dma->irq =
		platform_get_irq(pdev, 0);

	if (dma->irq < 0)
		return dma->irq;

	writel(0, dma->regs + P07_IRQ_ENABLE);
	writel(P07_IRQ_ALL, dma->regs + P07_IRQ_STATUS);
	(void)readl(dma->regs + P07_IRQ_STATUS);

	ret =
		devm_request_irq(&pdev->dev,
				 dma->irq,
				 project07_dma_irq,
				 0,
				 "project07-dma",
				 dma);

	if (ret)
		return ret;

	platform_set_drvdata(pdev, dma);

	dev_info(&pdev->dev,
		 "Project07 IRQ registered: Linux IRQ %d\n",
		 dma->irq);

	ret = project07_gate9l(pdev, dma);

	if (ret)
		return ret;

	dev_info(&pdev->dev,
		 "Project07 custom DMA hardware identified successfully\n");

	return 0;
}

static const struct of_device_id project07_dma_of_match[] = {
	{ .compatible = "xlnx,dma-ddr-gate-top-1.2" },
	{ }
};
MODULE_DEVICE_TABLE(of, project07_dma_of_match);

static struct platform_driver project07_dma_driver = {
	.probe = project07_dma_probe,
	.driver = {
		.name = "project07-dma",
		.of_match_table = project07_dma_of_match,
	},
};

module_platform_driver(project07_dma_driver);

